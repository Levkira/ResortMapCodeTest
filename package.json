{
  "name": "fullstack-one-command",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "express": "^5.2.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "vitest": "^1.0.0"
  },
  "scripts": {
    "server": "nodemon server/src/server.js",
    "client": "npm start --prefix client",
    "dev": "concurrently \"npm run server --\" \"npm run client\"",
    "test": "vitest",
    "test:run": "vitest run"
  }
}